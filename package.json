{
  "name": "radish-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/react", "packages/tokens"],
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "npm run dev --workspace @radish-ui/docs",
    "build": "npm run check && npm run build --workspace @radish-ui/docs",
    "preview": "npm run preview --workspace @radish-ui/docs",
    "check": "npm run check:repo && npm run check:tokens && npm run type-check",
    "check:repo": "node scripts/check-repo.mjs",
    "check:tokens": "node scripts/generate-tokens.mjs --check",
    "tokens:generate": "node scripts/generate-tokens.mjs",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
